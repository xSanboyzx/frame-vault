{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frame Vault",
  "version": "0.0.1",
  "identifier": "io.github.xsanboyzx.framevault",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run engine:bundle && npm run build:web",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Frame Vault",
        "width": 1100,
        "height": 760,
        "minWidth": 680,
        "minHeight": 560,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
